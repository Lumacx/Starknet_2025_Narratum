{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund",
      "npm --prefix \"$RESOURCE_DIR\" run build:deploy"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "hub":         { "host": "0.0.0.0", "port": 4400 },
    "logging":     { "host": "0.0.0.0", "port": 4500 },
    "apphosting":  { "host": "0.0.0.0", "port": 5002 },
    "auth":        { "host": "0.0.0.0", "port": 9099 },
    "firestore":   { "host": "0.0.0.0", "port": 8080 },
    "functions":   { "host": "0.0.0.0", "port": 5001 },
    "storage":     { "host": "0.0.0.0", "port": 9199 },
    "eventarc":    { "host": "0.0.0.0", "port": 9299 },
    "tasks":       { "host": "0.0.0.0", "port": 9499 },
    "hosting":     { "host": "0.0.0.0", "port": 5000 },
    "ui":          { "enabled": true, "host": "0.0.0.0", "port": 4005 },
    "dataconnect": { "host": "0.0.0.0", "port": 9399, "dataDir": "dataconnect/.dataconnect/pgliteData" }
  },
  "dataconnect": { "source": "dataconnect" },
  "apphosting": [
    {
      "backendId": "studio",
      "rootDir": ".",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "dataconnect/.dataconnect/**"]
    }
  ]
}
