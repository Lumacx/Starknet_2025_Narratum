  },
  "devDependencies": {
    "@firebase/data-connect": "^0.3.10",
    "@next/bundle-analyzer": "^15.5.3",
    "@types/archiver": "^6.0.3",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18",
