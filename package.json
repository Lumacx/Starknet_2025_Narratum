{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p $PORT",
    "deploy:prod": "pnpm -C functions build && pnpm dlx firebase-tools deploy --only apphosting,functions --project narratum",
    "deploy:prod:app": "pnpm dlx firebase-tools deploy --only apphosting --project narratum",
    "deploy:prod:functions": "pnpm -C functions build && pnpm dlx firebase-tools deploy --only functions --project narratum",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:baseline": "NODE_OPTIONS=--max_old_space_size=8192 next build",
    "build:nominify": "NEXT_SWC_MINIFY=false next build",
    "analyze": "ANALYZE=true next build",
    "clean:caches": "rm -rf .next/cache node_modules/.cache .turbo",
    "build:tmp": "TMPDIR=/tmp pnpm build",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "dc:enable": "firebase experiments:enable dataconnect",
    "dc:deploy": "firebase deploy --only dataconnect",
    "dc:codegen": "firebase dataconnect:sdk:generate --out dataconnect-generated/js",
    "dc:all": "npm run dc:deploy && npm run dc:codegen",
    "backfill:referrals": "node scripts/backfillReferralCodes.cjs"
  },
  "dependencies": {
    "@argent/x-ui": "^1.87.0",
    "@chakra-ui/react": "^2.8.2",
    "@chakra-ui/styled-system": "^2.9.2",
