rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Content-type helpers ----
    function isPng() { return request.resource.contentType == 'image/png'; }
    function isMp3() { 
      return request.resource.contentType == 'audio/mpeg' ||
             request.resource.contentType == 'audio/mp3';
    }
    function isMp4() { return request.resource.contentType == 'video/mp4'; }

    // ---- Size helper ----
    function sizeBetween(minBytes, maxBytes) {
      return request.resource.size >= minBytes && request.resource.size <= maxBytes;
    }

    // ---- Allowed assets (updated PNG max to 5 MB) ----
    function assetIsAllowed() {
      return
        (isPng() && sizeBetween(100 * 1024, 5 * 1024 * 1024)) ||     // PNG: 100 KB – 5 MB
        (isMp3() && sizeBetween(100 * 1024, 5 * 1024 * 1024)) ||     // MP3: 100 KB – 5 MB
        (isMp4() && sizeBetween(1 * 1024 * 1024, 50 * 1024 * 1024)); // MP4: 1 MB – 50 MB
    }

    // Avatars: avatars/{uid}/avatar.png (public read, owner write/delete)
    match /avatars/{uid}/{file=**} {
      allow read: if true;
      allow create, update: if isOwner(uid)
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // User gallery assets
    match /users/{uid}/assets/{file=**} {
      allow read: if isOwner(uid);                 // change to 'true' if you want public galleries
      allow create, update: if isOwner(uid) && assetIsAllowed();
      allow delete: if isOwner(uid);
    }

    // Public bucket area (optional)
    match /public/{file=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
