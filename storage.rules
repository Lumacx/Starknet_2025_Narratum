rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ---------- Helpers ---------- */
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Tipos MIME
    function isPng()  { return request.resource.contentType == 'image/png'; }
    function isJpg()  { return request.resource.contentType == 'image/jpeg'; }
    function isWebp() { return request.resource.contentType == 'image/webp'; }
    function isImg()  { return isPng() || isJpg() || isWebp(); }

    function isMp3()  {
      return request.resource.contentType == 'audio/mpeg' ||
             request.resource.contentType == 'audio/mp3';
    }
    function isWav()  {
      return request.resource.contentType == 'audio/wav' ||
             request.resource.contentType == 'audio/x-wav' ||
             request.resource.contentType == 'audio/wave';
    }

    function isMp4()  { return request.resource.contentType == 'video/mp4'; }

    // Límites de tamaño
    function sizeBetween(minBytes, maxBytes) {
      return request.resource.size >= minBytes && request.resource.size <= maxBytes;
    }

    /* ---------- Categorías para /users/{uid}/assets ---------- */
    function isImageCategory(cat) {
      return cat in ['covers','avatars','characters','locations','backgrounds'];
    }
    function isAudioCategory(cat) {
      return cat in ['audioNarrations','audioEffects'];
    }
    function isVideoCategory(cat) {
      return cat in ['videos'];
    }
    function isOtherCategory(cat) {
      return cat == 'others';
    }

    // Validación por categoría para uploads en /assets
    function assetValidForCategory(cat) {
      return
        // Imágenes: PNG/JPG/WEBP (50 KB – 10 MB)
        (isImageCategory(cat) && isImg() && sizeBetween(50*1024, 10*1024*1024)) ||

        // Audio: MP3/WAV (50 KB – 15 MB)
        (isAudioCategory(cat) && (isMp3() || isWav()) && sizeBetween(50*1024, 15*1024*1024)) ||

        // Video: MP4 (1 MB – 50 MB)
        (isVideoCategory(cat) && isMp4() && sizeBetween(1*1024*1024, 50*1024*1024)) ||

        // Otros (opcional y limitado)
        (isOtherCategory(cat) && (
          (isImg()  && sizeBetween(50*1024, 10*1024*1024)) ||
          (isMp3()  && sizeBetween(50*1024, 15*1024*1024)) ||
          (isWav()  && sizeBetween(50*1024, 15*1024*1024)) ||
          (isMp4()  && sizeBetween(1*1024*1024, 50*1024*1024))
        ));
    }

    /* ---------- Rutas principales ---------- */

    // Avatares de perfil (lectura pública opcional)
    match /avatars/{uid}/{file=**} {
      allow read: if true; // hazlo isOwner(uid) si quieres privacidad
      allow create, update: if isOwner(uid)
        && isImg()
        && sizeBetween(10*1024, 5*1024*1024); // 10 KB – 5 MB
      allow delete: if isOwner(uid);
    }

    // Galería / referencias del usuario (Support page)
    // /users/{uid}/assets/{category}/{file...}
    match /users/{uid}/assets/{category}/{file=**} {
      // Si deseas galerías públicas, cambia a: allow read: if true;
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && assetValidForCategory(category);
      allow delete: if isOwner(uid);
    }

    // Assets por historia (Begin / Scenes / Publish)
    // /users/{uid}/stories/{storyId}/{folder}/{file...}
    match /users/{uid}/stories/{storyId}/{folder}/{file=**} {
      // ⚠️ Lectura pública para consumo en el Reader/Discover.
      // Si manejas drafts privados, pon isOwner(uid) y copia a /public/ al publicar.
      allow read: if true;

      allow create, update: if isOwner(uid) && (
        // Imágenes (covers, páginas): PNG/JPG/WEBP (50 KB – 10 MB)
        ((folder == 'images') && isImg() && sizeBetween(50*1024, 10*1024*1024)) ||

        // Narraciones (MP3/WAV): 50 KB – 15 MB
        ((folder == 'audio') && (isMp3() || isWav()) && sizeBetween(50*1024, 15*1024*1024)) ||

        // Videos: MP4 (1 MB – 50 MB)
        ((folder == 'videos') && isMp4() && sizeBetween(1*1024*1024, 50*1024*1024))
      );

      allow delete: if isOwner(uid);
    }

    // Zona pública opcional (assets compartidos por la app)
    match /public/{file=**} {
      allow read: if true;
      // Si quieres que sólo un rol admin suba aquí, cambia esta regla
      allow write: if isSignedIn();
    }

    // Seguridad por defecto
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
