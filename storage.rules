rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ----------------- Helpers ----------------- */
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Image types
    function isPng()  { return request.resource.contentType == 'image/png'; }
    function isJpg()  { return request.resource.contentType == 'image/jpeg'; }
    function isWebp() { return request.resource.contentType == 'image/webp'; }
    function isImg()  { return isPng() || isJpg() || isWebp(); }

    // Audio types
    function isMp3()  {
      return request.resource.contentType == 'audio/mpeg' ||
             request.resource.contentType == 'audio/mp3';
    }
    function isWav()  {
      return request.resource.contentType == 'audio/wav' ||
             request.resource.contentType == 'audio/x-wav' ||
             request.resource.contentType == 'audio/wave';
    }

    // Video
    function isMp4()  { return request.resource.contentType == 'video/mp4'; }

    // Size guard
    function sizeBetween(minBytes, maxBytes) {
      return request.resource.size >= minBytes && request.resource.size <= maxBytes;
    }

    /* ----------------- /users/{uid}/assets categories ----------------- */
    function isImageCategory(cat) {
      return cat in ['covers','avatars','characters','locations','backgrounds'];
    }
    function isAudioCategory(cat) {
      return cat in ['audioNarrations','audioEffects'];
    }
    function isVideoCategory(cat) {
      return cat in ['videos'];
    }
    function isOtherCategory(cat) {
      return cat == 'others';
    }

    function assetValidForCategory(cat) {
      return
        // IMAGES: PNG/JPG/WEBP (50 KB – 12 MB)
        (isImageCategory(cat) && isImg() && sizeBetween(50*1024, 12*1024*1024)) ||

        // AUDIO: MP3/WAV (50 KB – 16 MB)
        (isAudioCategory(cat) && (isMp3() || isWav()) && sizeBetween(50*1024, 16*1024*1024)) ||

        // VIDEO: MP4 (1 MB – 64 MB)
        (isVideoCategory(cat) && isMp4() && sizeBetween(1*1024*1024, 64*1024*1024)) ||

        // OTHERS (conservador)
        (isOtherCategory(cat) && (
          (isImg()  && sizeBetween(50*1024, 12*1024*1024)) ||
          (isMp3()  && sizeBetween(50*1024, 16*1024*1024)) ||
          (isWav()  && sizeBetween(50*1024, 16*1024*1024)) ||
          (isMp4()  && sizeBetween(1*1024*1024, 64*1024*1024))
        ));
    }

    /* ----------------- Rutas principales ----------------- */

    // Avatares de perfil
    match /avatars/{uid}/{file=**} {
      // pública para perfiles; si quieres privacidad cambia a isOwner(uid)
      allow read: if true;
      allow create, update: if isOwner(uid)
        && isImg()
        && sizeBetween(10*1024, 5*1024*1024);
      allow delete: if isOwner(uid);
    }

    // Galería personal (Support page): /users/{uid}/assets/{category}/{file...}
    match /users/{uid}/assets/{category}/{file=**} {
      // Si quieres galerías públicas, cambia read a true
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && assetValidForCategory(category);
      allow delete: if isOwner(uid);
    }

    // Assets de historias (Begin/Scenes/Publish)
    // Estructura: /users/{uid}/stories/{storyId}/{folder}/{file...}
    match /users/{uid}/stories/{storyId}/{folder}/{file=**} {
      // ⚠️ Tu flujo de Reader/Discover consume público; mantenemos read:true.
      // Si más adelante quieres ocultar borradores, publica a /public/ o cambia esta regla.
      allow read: if true;

      // Validación por folder
      allow create, update: if isOwner(uid) && (
        // Covers y páginas → images
        ((folder == 'images') && isImg() && sizeBetween(30*1024, 12*1024*1024)) ||

        // Narraciones → audio
        ((folder == 'audio') && (isMp3() || isWav()) && sizeBetween(50*1024, 16*1024*1024)) ||

        // Videos
        ((folder == 'videos') && isMp4() && sizeBetween(1*1024*1024, 64*1024*1024))
      );

      allow delete: if isOwner(uid);
    }

    // Zona pública opcional de la app
    match /public/{file=**} {
      allow read: if true;
      // Restringe si deseas sólo admins
      allow write: if isSignedIn();
    }

    // Deny by default
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
