rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Types & sizes
    function isPng()  { return request.resource.contentType == 'image/png'; }
    function isMp3()  { return request.resource.contentType == 'audio/mpeg' || request.resource.contentType == 'audio/mp3'; }
    function isMp4()  { return request.resource.contentType == 'video/mp4'; }
    function sizeBetween(minBytes, maxBytes) {
      return request.resource.size >= minBytes && request.resource.size <= maxBytes;
    }

    // Category guards
    function isImageCategory(cat) {
      return cat in ['covers','avatars','characters','locations','backgrounds'];
    }
    function isAudioCategory(cat) {
      return cat in ['audioNarrations','audioEffects'];
    }
    function isVideoCategory(cat) {
      return cat in ['videos'];
    }
    function isOtherCategory(cat) {
      return cat == 'others';
    }

    // Per-category validation
    function assetValidForCategory(cat) {
      return
        (isImageCategory(cat) && isPng() && sizeBetween(100*1024, 5*1024*1024)) ||        // PNG 100KB–5MB
        (isAudioCategory(cat) && isMp3() && sizeBetween(100*1024, 5*1024*1024)) ||         // MP3 100KB–5MB
        (isVideoCategory(cat) && isMp4() && sizeBetween(1*1024*1024, 50*1024*1024)) ||     // MP4 1MB–50MB
        (isOtherCategory(cat) && (
            (isPng() && sizeBetween(100*1024, 5*1024*1024)) ||
            (isMp3() && sizeBetween(100*1024, 5*1024*1024)) ||
            (isMp4() && sizeBetween(1*1024*1024, 50*1024*1024))
        ));
    }

    // Avatars (public read if you want)
    match /avatars/{uid}/{file=**} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5*1024*1024;
      allow delete: if isOwner(uid);
    }

    // Categorized user assets
    match /users/{uid}/assets/{category}/{file=**} {
      allow read: if isOwner(uid); // set to 'true' if you want fully public galleries
      allow create, update: if isOwner(uid) && assetValidForCategory(category);
      allow delete: if isOwner(uid);
    }

    // Optional public area
    match /public/{file=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
