// firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------- Global Helpers ----------------- */
    function isSignedIn() { return request.auth != null; }

    // existing doc -> owner (requires { ownerUid } on the doc)
    function isOwnerDoc() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // incoming payload -> owner (requires { ownerUid } in request)
    function isOwnerCreate() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Require that a set of fields do NOT change across an update
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(fields);
    }

    // Published helpers
    function isPublishedBool(d) {
      return d.published == true;
    }
    function isPublishedAtNow(d) {
      return (d.publishedAt is timestamp) && d.publishedAt <= request.time;
    }
    function isPublicishData(d) {
      return isPublishedBool(d) ||
             isPublishedAtNow(d) ||
             (d.status == "published") ||
             (d.visibility == "public") ||
             (d.isPublic == true);
    }
    function isPublicStory() {
      return isPublicishData(resource.data);
    }

    // Story helpers
    function isStoryOwner(storyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid == request.auth.uid;
    }
    function storyIsPublic(storyId) {
      let s = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return isPublicishData(s);
    }
    function canReadStoryById(storyId) {
      return storyIsPublic(storyId) || isStoryOwner(storyId);
    }

    /* --------- Asset helpers (used under /users/{uid}/assetIndex) --------- */
    function allowedCategory(cat) {
      return cat in [
        'covers','avatars','characters','locations','backgrounds',
        'audioNarrations','audioEffects','videos','generatedImages','others'
      ];
    }
    function hasTimestampOrMissing(v) {
      return !(v in request.resource.data) || (request.resource.data[v] is timestamp);
    }
    function validAssetDoc(d) {
      return (d.url is string) &&
             (d.fileName is string) &&
             (d.contentType is string) &&
             (d.createdAt is timestamp) &&
             hasTimestampOrMissing('updatedAt') &&
             ( !('name' in d) || (d.name is string) ) &&
             ( !('nameLower' in d) || (d.nameLower is string) ) &&
             ( !('storagePath' in d) || (d.storagePath is string) ) &&
             ( !('role' in d) || (d.role is string) ) &&
             ( !('source' in d) || (d.source is string) ) &&
             ( !('storyId' in d) || (d.storyId is string || d.storyId == null) );
    }

    /* ============================================================
       TOP-LEVEL _meta
       ============================================================ */
    match /_meta/{docId} {
      allow read, write: if isSignedIn();
    }

    /* ============================================================
       USERS TREE
       ============================================================ */
    match /users/{uid} {

      // READ: owner OR the referrer of this user (needed for your “Referral Transactions” tab)
      // NEW: second condition enables `query(users where referredBy == request.auth.uid)`
      allow read: if isOwner(uid) || (isSignedIn() && resource.data.referredBy == request.auth.uid); // NEW

      // CREATE: owner only; limited fields
      allow create: if isOwner(uid)
        && !('plan' in request.resource.data)
        && !('subscriptionTier' in request.resource.data)
        && !('credits' in request.resource.data)
        && !('ownerUid' in request.resource.data)
        && !('email' in request.resource.data)
        && !('createdAt' in request.resource.data)
        && !('referralCode' in request.resource.data)
        && ( !('referredBy' in request.resource.data) || (request.resource.data.referredBy is string) );

      // UPDATE: owner may edit ONLY profile fields; server fields immutable
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName','bio','location','website','socials','walletAddress','photoURL'
        ])
        && unchanged(['plan','subscriptionTier','credits','ownerUid','email','createdAt','referredBy','referralCode']);

      allow delete: if isOwner(uid);

      match /_meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /assets/{assetId} {
        allow read, write: if isOwner(uid);
      }

      match /favorites/{favId} {
        allow read, write: if isOwner(uid);
      }

      match /reads/{storyId} {
        allow read, write: if isOwner(uid);
      }

      match /ratings/{storyId} {
        allow read, write: if isOwner(uid);
      }

      match /stories/{storyId} {
        allow read, write: if isOwner(uid);

        match /scenes/{sceneId} {
          allow read, write: if isOwner(uid);
        }
        match /assets/{assetId} {
          allow read, write: if isOwner(uid);
        }
      }

      /* users/{uid}/assetIndex */
      match /assetIndex/stories/{storyId}/{category}/{assetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && allowedCategory(category)
          && validAssetDoc(request.resource.data)
          && ( !('storyId' in request.resource.data) || request.resource.data.storyId == storyId );
        allow update: if isOwner(uid)
          && allowedCategory(category)
          && validAssetDoc(request.resource.data)
          && (resource.data.storyId == request.resource.data.storyId);
        allow delete: if isOwner(uid);
      }

      match /assetIndex/uncategorized/{category}/{assetId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && allowedCategory(category)
          && validAssetDoc(request.resource.data)
          && ( !('storyId' in request.resource.data) || request.resource.data.storyId == null );
        allow delete: if isOwner(uid);
      }

      /* users/{uid}/transactions — client read-only */
      match /transactions/{txId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }
    }

    /* ============================================================
       TOP-LEVEL STORIES
       ============================================================ */
    match /stories/{storyId} {
      allow create: if isOwnerCreate();
      allow read: if isPublicStory() || isOwnerDoc();
      allow update, delete: if isOwnerDoc()
        && request.resource.data.ownerUid == resource.data.ownerUid;

      match /ratings/{raterUid} {
        allow read: if canReadStoryById(storyId)
                || (isSignedIn() && request.auth.uid == raterUid);
        allow create, update, delete: if isSignedIn() && request.auth.uid == raterUid;
      }

      match /comments/{commentId} {
        allow read: if canReadStoryById(storyId);
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId;

        match /reactions/{userId} {
          allow read: if canReadStoryById(storyId);
          allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }
      }

      match /reactions/{userId} {
        allow read: if canReadStoryById(storyId);
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    /* ============================================================
       TOP-LEVEL storyContents
       ============================================================ */
    match /storyContents/{id} {
      function storyIdFromExisting() { return resource != null ? resource.data.storyId : null; }
      function storyIdFromRequest()  { return request.resource != null ? request.resource.data.storyId : null; }
      function effectiveStoryId()    { return storyIdFromExisting() != null ? storyIdFromExisting() : storyIdFromRequest(); }

      allow read: if effectiveStoryId() != null && canReadStoryById(effectiveStoryId());
      allow create: if effectiveStoryId() != null && isStoryOwner(effectiveStoryId());
      allow update, delete: if effectiveStoryId() != null
        && isStoryOwner(effectiveStoryId())
        && request.resource.data.storyId == resource.data.storyId;
    }

    /* ----------------- Default deny ----------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
