rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helpers ---------- */
    function isSignedIn() {
      return request.auth != null;
    }

    // Existing doc -> owner (expects { ownerUid } on the doc)
    function isOwnerDoc() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Incoming payload -> owner (expects { ownerUid } in request body)
    function isOwnerCreate() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function isPublicStory() {
      return resource.data.status == "published" && resource.data.visibility == "public";
    }

    // Resolve story ownership/public from a top-level storyId
    function isStoryOwner(storyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid == request.auth.uid;
    }

    function storyIsPublic(storyId) {
      let s = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return s.status == "published" && s.visibility == "public";
    }

    /* ============================================================
       USERS TREE  (used by the new Scenes page)
       - users/{uid}               -> private profile (already had)
       - users/{uid}/assets/{id}   -> user's gallery items
       - users/{uid}/stories/{id}  -> user's WIP stories (no ownerUid required)
         - scenes/{sceneId}        -> optional per-scene docs (if you use them)
         - assets/{assetId}        -> optional story-scoped assets
       All owner-gated by path uid, so we don't require {ownerUid} here.
       ============================================================ */
    match /users/{uid} {
      // Profile doc (unchanged)
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // ✅ Subcolección META del usuario (keepalive y flags)
      match /_meta/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
       }

      // User gallery (characters, locations, narrations, sfx, videos)
      match /assets/{assetId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // User-scoped stories (the Scenes page writes here)
      match /stories/{storyId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;

        // OPTIONAL: if you break scenes into subcollection docs
        match /scenes/{sceneId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }

        // OPTIONAL: story-scoped assets (e.g., renders attached to a story)
        match /assets/{assetId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    /* ============================================================
       TOP-LEVEL STORIES (public/published + owner rules)
       Keeps your original model for public discovery/publishing.
       ============================================================ */
    match /stories/{storyId} {
      // Create must include ownerUid == caller
      allow create: if isOwnerCreate();

      // Reads: public published stories OR owner reads anything
      allow read: if isPublicStory() || isOwnerDoc();

      // Only owner may update/delete
      allow update, delete: if isOwnerDoc();
    }

    /* ============================================================
       TOP-LEVEL storyContents (page documents)
       Read if parent story is public+published OR caller owns it.
       Only the parent story owner can write.
       ============================================================ */
    match /storyContents/{id} {
      function storyIdFromExisting() {
        return resource != null ? resource.data.storyId : null;
      }
      function storyIdFromRequest() {
        return request.resource != null ? request.resource.data.storyId : null;
      }
      function effectiveStoryId() {
        return storyIdFromExisting() != null ? storyIdFromExisting() : storyIdFromRequest();
      }

      allow read: if (effectiveStoryId() != null && storyIsPublic(effectiveStoryId()))
               || (effectiveStoryId() != null && isStoryOwner(effectiveStoryId()));

      allow create, update, delete: if (effectiveStoryId() != null && isStoryOwner(effectiveStoryId()));
    }

    /* ---------- Default deny ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
