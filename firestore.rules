rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------- Helpers ----------------- */
    function isSignedIn() { return request.auth != null; }

    // existing doc -> owner (requires { ownerUid } on the doc)
    function isOwnerDoc() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // incoming payload -> owner (requires { ownerUid } in request)
    function isOwnerCreate() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // 👇 NEW: “public enough” if ANY of these is true
    function isPublicishData(d) {
      return (d.status == "published") ||
             (d.visibility == "public") ||
             (d.isPublic == true);
    }

    // For the story doc currently matched
    function isPublicStory() {
      return isPublicishData(resource.data);
    }

    // Check ownership of top-level story
    function isStoryOwner(storyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid == request.auth.uid;
    }

    // Load a story and test “public-ish”
    function storyIsPublic(storyId) {
      let s = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return isPublicishData(s);
    }

    function canReadStoryById(storyId) {
      return storyIsPublic(storyId) || isStoryOwner(storyId);
    }

    /* ============================================================
       USERS TREE (path-scoped; no exige ownerUid en el doc)
       ============================================================ */
    match /users/{uid} {
      // Perfil del usuario
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // _meta (keepalive/flags)
      match /_meta/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Galería
      match /assets/{assetId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Favoritos (usado en discover/profile)
      match /favorites/{favId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Historias WIP del usuario
      match /stories/{storyId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;

        match /scenes/{sceneId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }

        match /assets/{assetId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    /* ============================================================
       TOP-LEVEL STORIES (descubrimiento/publishing)
       ============================================================ */
    match /stories/{storyId} {
      // Crear: debe venir con ownerUid == caller
      allow create: if isOwnerCreate();

      // 👇 Leer: público (ANY of the flags) o dueño
      allow read: if isPublicStory() || isOwnerDoc();

      // Actualizar/Eliminar: sólo dueño + congelar ownerUid
      allow update, delete: if isOwnerDoc()
        && request.resource.data.ownerUid == resource.data.ownerUid;

      /* ---------- Subcolecciones bajo stories ---------- */

      // Ratings: clave = uid del rater
      match /ratings/{raterUid} {
        // Leer: si story es público o caller es dueño del story o caller lee su propio rating
        allow read: if canReadStoryById(storyId)
                 || (isSignedIn() && request.auth.uid == raterUid);

        // Escribe/actualiza/elimina: sólo el propio rater
        allow create, update, delete: if isSignedIn() && request.auth.uid == raterUid;
      }

      // Comments
      match /comments/{commentId} {
        // Leer: si story es público o caller es dueño del story
        allow read: if canReadStoryById(storyId);

        // Crear: user autenticado; guarda authorId y congélalo
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;

        // Update/Delete: sólo el autor del comentario
        allow update, delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId;

        // Reacciones a un comentario
        match /reactions/{userId} {
          allow read: if canReadStoryById(storyId);
          allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }
      }

      // Reacciones directas al story
      match /reactions/{userId} {
        allow read: if canReadStoryById(storyId);
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    /* ============================================================
       TOP-LEVEL storyContents (pages/segments)
       ============================================================ */
    match /storyContents/{id} {

      function storyIdFromExisting() {
        return resource != null ? resource.data.storyId : null;
      }

      function storyIdFromRequest() {
        return request.resource != null ? request.resource.data.storyId : null;
      }

      function effectiveStoryId() {
        return storyIdFromExisting() != null ? storyIdFromExisting() : storyIdFromRequest();
      }

      // read (get + list)
      allow read: if effectiveStoryId() != null && canReadStoryById(effectiveStoryId());

      // create: sólo si caller es dueño del story
      allow create: if effectiveStoryId() != null && isStoryOwner(effectiveStoryId());

      // update/delete: dueño + no permitir cambiar storyId
      allow update, delete: if effectiveStoryId() != null
        && isStoryOwner(effectiveStoryId())
        && request.resource.data.storyId == resource.data.storyId;
    }

    /* ----------------- Default deny ----------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
