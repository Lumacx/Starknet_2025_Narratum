// firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------- Global Helpers ----------------- */
    function isSignedIn() { return request.auth != null; }

    // existing doc -> owner (requires { ownerUid } on the doc)
    function isOwnerDoc() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // incoming payload -> owner (requires { ownerUid } in request)
    function isOwnerCreate() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Require that a set of fields do NOT change across an update
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(fields);
    }

    // Published helpers
    function isPublishedBool(d) {
      return d.published == true;
    }
    function isPublishedAtNow(d) {
      return (d.publishedAt is timestamp) && d.publishedAt <= request.time;
    }
    function isPublicishData(d) {
      return isPublishedBool(d) ||
             isPublishedAtNow(d) ||
             (d.status == "published") ||
             (d.visibility == "public") ||
             (d.isPublic == true);
    }
    function isPublicStory() {
      return isPublicishData(resource.data);
    }

    // Story helpers
    function isStoryOwner(storyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid == request.auth.uid;
    }
    function storyIsPublic(storyId) {
      let s = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return isPublicishData(s);
    }
    function canReadStoryById(storyId) {
      return storyIsPublic(storyId) || isStoryOwner(storyId);
    }

    function isTimestampOrMissing(field) {
      return !(field in request.resource.data) || (request.resource.data[field] is timestamp);
    }
    function isStringOrMissing(field) {
      return !(field in request.resource.data) || (request.resource.data[field] is string);
    }
    
    // Valid story types
    function isValidStoryType(type) {
        return type in ['basic', 'premium', 'convai'];
    }

    // Validates a YouTube link doc stored in the gallery
    function validVideoLink(d, uid, storyId) {
      return
        (d.ownerUid == uid) &&
        // storyId must match (or be null for uncategorized)
        (
          (storyId == null && (!('storyId' in d) || d.storyId == null)) ||
          (storyId != null && d.storyId == storyId)
        ) &&
        (d.url is string) &&                            // canonical watch URL
        ( !('embedUrl' in d)   || (d.embedUrl   is string) ) &&
        ( !('thumbUrl' in d)   || (d.thumbUrl   is string) ) &&
        ( !('provider' in d)   || (d.provider   in ['youtube']) ) &&
        ( !('kind' in d)       || (d.kind       in ['video']) ) &&
        ( !('contentType' in d)|| (d.contentType is string) ) &&
        isTimestampOrMissing('createdAt') &&
        isTimestampOrMissing('updatedAt');
    }


    /* --------- Legacy Asset helpers (under /users/{uid}/assetIndex) --------- */
    function allowedCategory(cat) {
      return cat in [
        'covers','avatars','characters','locations','backgrounds',
        'audioNarrations','audioEffects','generatedImages','others'
      ];
    }
    function hasTimestampOrMissing(v) {
      return !(v in request.resource.data) || (request.resource.data[v] is timestamp);
    }
    function validAssetDoc(d) {
      return (d.url is string) &&
             (d.fileName is string) &&
             (d.contentType is string) &&
             (d.createdAt is timestamp) &&
             hasTimestampOrMissing('updatedAt') &&
             ( !('name' in d) || (d.name is string) ) &&
             ( !('nameLower' in d) || (d.nameLower is string) ) &&
             ( !('storagePath' in d) || (d.storagePath is string) ) &&
             ( !('role' in d) || (d.role is string) ) &&
             ( !('source' in d) || (d.source is string) ) &&
             ( !('storyId' in d) || (d.storyId is string || d.storyId == null) );
    }

    /* --------- NEW Asset-Hub helpers (Option B) --------- */
    function allowedAssetType(t) {
      return t in ['images','audio','narration','soundfx','videos'];
    }
    
    function validStoryAsset(d, uid, storyId, assetType) {
      // Required fields
      return
        (d.ownerUid == uid) &&
        (d.storyId == storyId) &&
        (d.assetType == assetType) &&

        // Optional but type-checked
        ( !('kind' in d) || (d.kind in ['page','teaser','raw']) ) &&
        ( !('source' in d) || (d.source in ['storage','youtube']) ) &&
        isStringOrMissing('youtubeUrl') &&
        isStringOrMissing('storagePath') &&
        isStringOrMissing('mimeType') &&
        isTimestampOrMissing('createdAt') &&   // recommend serverTimestamp()
        ( !('pageNumber' in d) || (d.pageNumber is int || d.pageNumber == null) ) &&
        ( !('sceneIndex' in d) || (d.sceneIndex is int || d.sceneIndex == null) ) &&
        ( !('name' in d) || (d.name is string) ) &&
        ( !('tags' in d) || (d.tags is list) );
    }

    /* ===========================================================
       TOP-LEVEL _meta
       ============================================================ */
    match /_meta/{docId} {
      allow read, write: if isSignedIn();
    }

    /* ===========================================================
       USERS TREE
       ============================================================ */
    match /users/{uid} {

      // READ: owner OR the referrer of this user (for “Referral Transactions” tab)
      allow read: if isOwner(uid) || (isSignedIn() && resource.data.referredBy == request.auth.uid);

      // CREATE: owner only; limited fields
      allow create: if isOwner(uid)
        && !('plan' in request.resource.data)
        && !('subscriptionTier' in request.resource.data)
        // Allow 'credits' and 'lastMonthlyCreditGrant' to be set on creation by server (e.g., auth trigger)
        && ( !('credits' in request.resource.data) || (request.resource.data.credits is int && request.resource.data.credits >= 0) )
        && ( !('lastMonthlyCreditGrant' in request.resource.data) || (request.resource.data.lastMonthlyCreditGrant is timestamp) )
        && !('ownerUid' in request.resource.data)
        && !('email' in request.resource.data)
        && !('createdAt' in request.resource.data)
        && !('referralCode' in request.resource.data)
        && ( !('referredBy' in request.resource.data) || (request.resource.data.referredBy is string) );

      // UPDATE: owner may edit ONLY profile fields; server fields immutable
      // Credits and lastMonthlyCreditGrant can only be changed by server-side functions (Admin SDK)
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName','bio','location','website','socials','walletAddress','photoURL'
        ])
        && unchanged(['plan','subscriptionTier','credits','ownerUid','email','createdAt','referredBy','referralCode', 'lastMonthlyCreditGrant']);

      allow delete: if isOwner(uid);

      match /_meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /assets/{assetId} {
        allow read, write: if isOwner(uid);
      }

      match /favorites/{favId} {
        allow read, write: if isOwner(uid);
      }

      match /reads/{storyId} {
        allow read, write: if isOwner(uid);
      }

      match /ratings/{storyId} {
        allow read, write: if isOwner(uid);
      }

      match /stories/{storyId} {
        allow read, write: if isOwner(uid);

        match /scenes/{sceneId} {
          allow read, write: if isOwner(uid);
        }
        match /assets/{assetId} {
          allow read, write: if isOwner(uid);
        }
      }

      /* ---------- Legacy: users/{uid}/assetIndex/stories/{storyId}/{category}/{assetId} ---------- */
      match /assetIndex/stories/{storyId}/{category}/{assetId} {
        allow read: if isOwner(uid) || storyIsPublic(storyId);
        allow create: if isOwner(uid)
          && allowedCategory(category)
          && validAssetDoc(request.resource.data)
          && ( !('storyId' in request.resource.data) || request.resource.data.storyId == storyId );
        allow update: if isOwner(uid)
          && allowedCategory(category)
          && validAssetDoc(request.resource.data)
          && (resource.data.storyId == request.resource.data.storyId);
        allow delete: if isOwner(uid);
      }
      
      /* ---------- Legacy: users/{uid}/assetIndex/stories/{storyId}/videos/{videoId} (6 segments after users/{uid}/) ---------- */
      // This rule is added to handle the video path with 6 segments.
      match /assetIndex/stories/{storyId}/videos/{videoId} {
        allow read: if isOwner(uid) || storyIsPublic(storyId);

        allow create: if isOwner(uid)
          && validVideoLink(request.resource.data, uid, storyId);

        allow update: if isOwner(uid)
          && validVideoLink(request.resource.data, uid, storyId)
          && (request.resource.data.ownerUid == resource.data.ownerUid)
          && (request.resource.data.storyId  == resource.data.storyId);

        allow delete: if isOwner(uid);
      }


      /* ---------- Legacy: users/{uid}/assetIndex/uncategorized/{category}/{assetId} ---------- */
      match /assetIndex/uncategorized/{category}/{assetId} {
        allow read: if isOwner(uid) || storyIsPublic(storyId);
        allow create, update: if isOwner(uid)
          && allowedCategory(category)
          && validAssetDoc(request.resource.data)
          && ( !('storyId' in request.resource.data) || request.resource.data.storyId == null );
        allow delete: if isOwner(uid);
      }

      /* ---------- NEW: assetIndex videos (7 segments) ---------- */
      /* Story-scoped: users/{uid}/assetIndex/default/stories/{storyId}/videos/{videoId} */
      match /assetIndex/default/stories/{storyId}/videos/{videoId} {
        // Read in editor by owner; optionally allow if the story is public
        allow read: if isOwner(uid) || storyIsPublic(storyId);

        allow create: if isOwner(uid)
          && validVideoLink(request.resource.data, uid, storyId);

        allow update: if isOwner(uid)
          && validVideoLink(request.resource.data, uid, storyId)
          && (request.resource.data.ownerUid == resource.data.ownerUid)
          && (request.resource.data.storyId  == resource.data.storyId);

        allow delete: if isOwner(uid);
      }

      /* Uncategorized: users/{uid}/assetIndex/default/uncategorized/videos/{videoId} */
      match /assetIndex/default/uncategorized/videos/{videoId} {
        allow read: if isOwner(uid) || storyIsPublic(storyId);

        allow create, update: if isOwner(uid)
          && validVideoLink(request.resource.data, uid, null);

        allow delete: if isOwner(uid);
      }


      /* ---------- NEW: Asset Hub (Option B) ---------- */
      // Hub document itself (e.g., /assetIndex/default/stories/{storyId}/storyAssets/default)
      match /assetIndex/default/stories/{storyId}/storyAssets/{storyAssetsDoc} {
        // Readable by owner OR if the corresponding story is public
        allow read: if isOwner(uid) || storyIsPublic(storyId);
        // Only owner can write/manage the hub doc
        allow write, update, delete: if isOwner(uid);
      }

      // Asset collections under the hub doc (images, audio, narration, soundfx, videos)
      match /assetIndex/default/stories/{storyId}/storyAssets/{storyAssetsDoc}/{assetType}/{assetId} {
        allow read: if (isOwner(uid) || storyIsPublic(storyId))
                    && allowedAssetType(assetType);

        allow create: if isOwner(uid)
                      && allowedAssetType(assetType)
                      && validStoryAsset(request.resource.data, uid, storyId, assetType);

        allow update: if isOwner(uid)
                      && allowedAssetType(assetType)
                      && validStoryAsset(request.resource.data, uid, storyId, assetType)
                      && (request.resource.data.ownerUid == resource.data.ownerUid)
                      && (request.resource.data.storyId == resource.data.storyId)
                      && (request.resource.data.assetType == resource.data.assetType);

        allow delete: if isOwner(uid) && allowedAssetType(assetType);
      }

      /* users/{uid}/transactions — client read-only */
      match /transactions/{txId} {
        allow read: if isOwner(uid); // Only owner can read their own transactions
        allow create: if false; // Only server can create transactions
        allow update, delete: if false;
        // Further validation for transaction fields will be in Cloud Functions for server-side writes
      }
    }

    /* ===========================================================
       TOP-LEVEL STORIES
       ============================================================ */
    match /stories/{storyId} {
      allow create: if isOwnerCreate() && request.resource.data.type is string && isValidStoryType(request.resource.data.type);
      allow read: if isPublicStory() || isOwnerDoc();
      allow update, delete: if isOwnerDoc()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && ( !('type' in request.resource.data) || isValidStoryType(request.resource.data.type) ) // Allow type update by owner, with validation
        && unchanged(['ownerUid']); // ownerUid should not change on update

      match /ratings/{raterUid} {
        allow read: if canReadStoryById(storyId)
                || (isSignedIn() && request.auth.uid == raterUid);
        allow create, update, delete: if isSignedIn() && request.auth.uid == raterUid;
      }

      match /comments/{commentId} {
        allow read: if canReadStoryById(storyId);
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId;

        match /reactions/{userId} {
          allow read: if canReadStoryById(storyId);
          allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }
      }

      match /reactions/{userId} {
        allow read: if canReadStoryById(storyId);
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    /* ===========================================================
       TOP-LEVEL storyContents
       ============================================================ */
    match /storyContents/{id} {
      function storyIdFromExisting() { return resource != null ? resource.data.storyId : null; }
      function storyIdFromRequest()  { return request.resource != null ? request.resource.data.storyId : null; }
      function effectiveStoryId()    { return storyIdFromExisting() != null ? storyIdFromExisting() : storyIdFromRequest(); }

      allow read: if effectiveStoryId() != null && canReadStoryById(effectiveStoryId());
      allow create: if effectiveStoryId() != null && isStoryOwner(effectiveStoryId());
      allow update, delete: if effectiveStoryId() != null
        && isStoryOwner(effectiveStoryId())
        && request.resource.data.storyId == resource.data.storyId;
    }

    /* ----------------- Default deny ----------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
