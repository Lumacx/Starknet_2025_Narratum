{
  "name": "narratum-functions",
  "private": true,
  "version": "0.1.0",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "build:deploy": "rimraf lib tsconfig.tsbuildinfo && tsc -p tsconfig.json && node -e \"['./lib/index.js','./lib/imageGeneration.js','./lib/authTriggers.js','./lib/commentCounter.js','./lib/assetsIndex.js'].forEach(p=>require('fs').accessSync(p))\" && ls -la lib",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@google-cloud/aiplatform": "^5.6.0",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "google-auth-library": "^9.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}